{
  "manifest_version": 3,
  "name": "Логистический калькулятор объема",
  "version": "1.1",
  "description": "Умный автоанализ габаритов и расчет кубических метров",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
